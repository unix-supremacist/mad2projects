# === Game install directories (proprietary commercial game, never redistribute) ===
/mad2/
/mad2russia/
/mad2demo/
/mad2raw/

# === Wine prefix (regenerated environment, not source) ===
/wineprefixes/

# === CMake/Ninja build output ===
/build/

# === Packaging script output (tools/package.sh / `just package`) ===
/dist/

# === Proprietary ROM/ISO files (user-supplied symlinks, never redistribute) ===
*.z64
*.iso
*.nes
*.fds
*.rom

# === extern/ vendored forks: ignore build output, ISO/ROM-extracted assets, ===
# === decompiler output, fetched third-party deps, logs, and runtime save   ===
# === state; keep the actual (hand-patched) fork source.                   ===
extern/jak-project/build/
extern/jak-project/out/
extern/jak-project/iso_data/
extern/jak-project/decompiler_out/
extern/jak-project/third-party/
extern/jak-project/log/
extern/jak-project/saves_chaos/
extern/jak-project/saves_chaos_verify/

# extern/mario-legacy isn't ready to vendor yet (still needs the same title-screen-skip
# patches ported from extern/jak-project) -- ignore the whole thing for now, prebuilt
# binaries included, until it's actually been patched.
extern/mario-legacy/

extern/sm64ex-alo/build/
extern/sm64ex-alo/build-windows/

# Fetched mingw-devel SDL packages (regenerated by justfile's build-*-windows targets)
extern/.sdl2-mingw/
extern/.sdl3-mingw/

# Fetched libretro core binaries (regenerated by `just fetch-libretro-fceumm`)
extern/.libretro-cores/

# === mad2music: audio clips include licensed/copyrighted tracks; keep only ===
# === the tracklist/copyright manifests and downloader source.             ===
mad2music/audio/**/*.ogg
mad2music/audio/**/*.wav
mad2music/audio/**/*.mp3
mad2music/audio/**/*.flac
mad2music/build/
mad2music/build-windows/

# === Compiled Go binaries checked out alongside their own source (rebuildable) ===
/mad2arc/mad2arc
/mad2repack/mad2repack
/mad2tool/mad2tool
/mad2save/mad2save
/mad2savegui/mad2savegui
/mad2transitions/mad2transitions
/mad2relauncher/mad2relauncher
/mad2launcher/mad2launcher
/mad2leveleditor/mad2leveleditor
/mad2music/downloader/mad2music-downloader
/mad2musicpatch/mad2musicpatch
/mad2repack_bin

# === Logs (mods log into the deployed game dir, already ignored above; ===
# === anything elsewhere is a stray run artifact) ===
*.log

# === Personal/local, machine-specific state ===
/mad2launcher_settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# === Leftover duplicate archive (superseded by tracked mad2iga/mad2repack/mad2tool source) ===
/Archive.zip

# === Proprietary game/demo archives, extracted game assets & romhack patches ===
# === (copyrighted content, never redistribute — same policy as /mad2/).       ===
# === No .7z is ever source here; they're all game-binary/asset dumps.         ===
*.7z
/global/
/SM Star Road Final (PPF).zip

# === Wii demo reference: the Wii game ELF and its symbol/binary dumps are ===
# === copyrighted game code (never redistribute). Keep only our own schema  ===
# === extraction script — wii_field_schema.json it produces is already      ===
# === tracked under mad2iga/, so no second copy is committed here.          ===
/wii_demo_ref/*
!/wii_demo_ref/extract_schema.py

# === Additional build output (rebuildable) ===
/mad2xdeltagen/build/
